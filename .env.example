# Slack app credentials (Socket Mode). Create the app at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Anthropic API key. Leave unset if you use `ant auth login` instead.
ANTHROPIC_API_KEY=

# Model used to read notes. Defaults to claude-opus-5-5.
# claude-haiku-5-5 is a much cheaper option for this simple extraction task.
CLAUDE_MODEL=claude-opus-5-5

# Hard monthly spend cap for Claude calls, in US dollars.
MONTHLY_BUDGET_USD=10

# Path to the client alias directory (see data/clients.example.json).
CLIENTS_FILE=data/clients.example.json

# Time zone used to resolve words like "today" and "yesterday".
TIMEZONE=America/Boise
